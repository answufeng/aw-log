<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AwLogdemo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorTertiary">@color/colorAccent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
    </style>
    <style name="CardSection" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/console_border</item>
        <item name="contentPadding">12dp</item>
        <item name="cardCornerRadius">8dp</item>
    </style>
    <style name="SectionTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="SectionSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="ConsoleText" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/console_text</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Widget.Button.Compact" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Button.Compact.Filled" parent="Widget.Material3.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>